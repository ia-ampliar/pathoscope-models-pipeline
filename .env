# Copie para .env e ajuste os caminhos:
#   cp .env.example .env

# Caminho da imagem DENTRO do container (pasta montada em /data)
# Ex.: /data/TCGA-BR-7197-01A-01-BS1.2fbf309e-bb43-49d2-aae9-b3016a520722.svs
IMAGE_PATH=/data/TCGA-BR-7197-01A-01-BS1.2fbf309e-bb43-49d2-aae9-b3016a520722.svs

# Pasta local com as imagens WSI (montada como /data no container)
DATA_DIR=./img_test/cancer

# Pasta local para saídas (montada como /app/output no container)
OUTPUT_DIR=./output

# Modo de saída do heatmap: overlay (JPG+NPZ) ou matrix_only (apenas NPZ)
OUTPUT_HEATMAP_MODE=matrix_only
